{
  "name": "@lobbify/anvil",
  "version": "0.1.0",
  "description": "Reproducible, content-addressed build system for Minecraft instances — git + docker + uv for .minecraft.",
  "keywords": [
    "minecraft",
    "modpack",
    "content-addressed",
    "reproducible",
    "lockfile",
    "fabric",
    "modrinth",
    "curseforge"
  ],
  "homepage": "https://github.com/lobbify/lobbify-anvil#readme",
  "bugs": {
    "url": "https://github.com/lobbify/lobbify-anvil/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobbify/lobbify-anvil.git"
  },
  "license": "Apache-2.0",
  "author": "Lobbify",
  "type": "module",
  "engines": {
    "node": ">=20 <21 || >=22 <23"
  },
  "bin": {
    "lobbify-anvil": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "check": "biome check && tsc --noEmit && vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "clipanion": "^3.2.1",
    "ink": "^5.2.1",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "semver": "^7.8.5",
    "smol-toml": "^1.3.1",
    "undici": "^6.21.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.31",
    "@types/semver": "^7.7.1",
    "@types/yauzl": "^2.10.3",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
